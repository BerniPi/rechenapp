# Kopieren nach server/.env und anpassen
ADMIN_PASSWORT=bitte-ein-langes-passwort
# Nur nötig, wenn die App woanders liegt (z. B. GitHub Pages), mehrere mit Komma:
ERLAUBTE_ORIGIN=

# Anmeldung: codes (Einmal-Codes) | piazzi (Konto mit freigegebener Adresse) | bgbb (Microsoft-Schulkonto)
ANMELDUNG=codes
# Erlaubte Mail-Domain; leer = piazzi.at bzw. bgblumenstrasse.at
MAIL_DOMAIN=

# Nur für bgbb – aus der App-Registrierung in Microsoft Entra ID:
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Adresse, unter der App und Server öffentlich erreichbar sind (ohne / am Ende)
OEFFENTLICHE_ADRESSE=https://rechnen.example.at
